# URL da API Laravel SEM o sufixo /api.
# Opcional: se não for definida, o app detecta o IP do computador automaticamente (Expo Go)
# ou usa 10.0.2.2 (emulador Android) / 127.0.0.1 (iOS Simulator e web).
#
# Exemplo (celular físico na mesma rede Wi-Fi):
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
EXPO_PUBLIC_API_URL=
